---
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource/ibm-plex-mono/500.css';
import '@fontsource/ibm-plex-mono/600.css';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/motion.css';
import fontUrl from '@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-wght-normal.woff2?url';
import SeoHead from '../components/SeoHead.astro';
import { clientMessagesJson } from '../i18n/messages';
import { depthOf, installPageMotion, motionKind } from '../lib/motion';
import type { PageSeo } from '../lib/seo-types';

interface Props {
  seo: PageSeo;
  withDock?: boolean;
  /** "brand" paints the page ultramarine; iOS colours the installed app's status bar from the page background. */
  ground?: 'brand';
}

const { seo, withDock = false, ground } = Astro.props;
// Browser scripts read their texts here, in the page language only.
const clientMessages = clientMessagesJson(seo.lang);
// Must run before the page is revealed, so it is written into the <head> rather than bundled.
const pageMotion = `${depthOf}\n${motionKind}\n(${installPageMotion})();`;
---

<!doctype html>
<html lang={seo.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, interactive-widget=resizes-content" />
    <meta name="theme-color" content="#4B3BFF" />
    <!-- "default": iOS keeps an opaque bar coloured from the page. "black-translucent" draws under the clock and, on iOS 26, lifts fixed bottom bars off the screen edge. -->
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="preload" href={fontUrl} as="font" type="font/woff2" crossorigin />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Telko" />
    <SeoHead seo={seo} />
    <script is:inline set:html={pageMotion} />
    <script is:inline>
      try {
        const theme = localStorage.getItem('telko.theme');
        if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
      } catch {}
    </script>
  </head>
  <body class:list={{ 'has-dock': withDock }} data-ground={ground}>
    <slot />
    <p class="visually-hidden" role="status" aria-live="polite" data-app-status></p>
    <script is:inline type="application/json" id="i18n-data" set:html={clientMessages} />
    <script>
      import { startPwa } from '../scripts/pwa';

      startPwa();
    </script>
  </body>
</html>

<style is:global>
  body[data-ground='brand'] {
    background: var(--action);
  }

  body.has-dock {
    padding-bottom: calc(96px + env(safe-area-inset-bottom, 0px));
  }
</style>
