---
import AppLayout from '../layouts/AppLayout.astro';
import { splashSeo } from '../lib/seo';
import { DEFAULT_COUNTRY } from '../config';
---

<AppLayout seo={splashSeo()} ground="brand">
  <main class="splash" aria-busy="true">
    <span class="wordmark" role="img" aria-label="Telko">telk<span class="dot"></span></span>
    <span class="keys" aria-hidden="true">
      <span></span>
      <span></span>
      <span></span>
    </span>
    <span class="visually-hidden" role="status">Telko</span>
    <noscript>
      <a class="fallback" href={`/${DEFAULT_COUNTRY}`}>Telko</a>
    </noscript>
  </main>
</AppLayout>

<script>
  import { DEFAULT_COUNTRY } from '../config';
  import { resolveLang } from '../i18n/detect';
  import { localePath } from '../i18n/paths';
  import { readPref } from '../scripts/prefs';

  const SPLASH_MS = 500;
  const onboarded = readPref('onboarded') !== null;
  // A saved choice wins, then the browser language: French for fr*, English otherwise.
  const lang = resolveLang(readPref('lang'), onboarded, navigator.languages ?? [navigator.language]);
  const country = readPref('country') ?? DEFAULT_COUNTRY;
  const operator = readPref('operator');
  // Home screen shortcuts from the web manifest open "/?go=…".
  const shortcut: Record<string, string> = { recherche: `/${country}/recherche`, internet: operator ? `/${country}/${operator}/internet` : `/${country}` };
  const go = shortcut[new URLSearchParams(window.location.search).get('go') ?? ''];
  const target = localePath(lang, onboarded ? (go ?? `/${country}`) : '/bienvenue');

  window.setTimeout(() => window.location.replace(target), SPLASH_MS);
</script>

<style>
  .splash {
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-8);
    background: var(--action);
    color: var(--on-action);
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    font-size: 64px;
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1;
    animation: rise 0.5s ease-out both;
  }

  .dot {
    width: 34px;
    height: 34px;
    margin: 18px 0 0 6px;
    border-radius: 50%;
    background: #b8b0ff;
    animation: pulse 1.2s ease-in-out infinite;
  }

  .keys {
    display: flex;
    gap: var(--space-3);
  }

  .keys span {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: #ffffff;
    opacity: 0.3;
    animation: key 1.2s ease-in-out infinite;
  }

  .keys span:nth-child(2) {
    animation-delay: 0.2s;
  }

  .keys span:nth-child(3) {
    animation-delay: 0.4s;
  }

  .fallback {
    color: var(--on-action);
    font-weight: 800;
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }

  @keyframes pulse {
    50% {
      transform: scale(1.12);
      background: #ffffff;
    }
  }

  @keyframes key {
    40% {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .wordmark,
    .dot,
    .keys span {
      animation: none;
    }

    .keys span {
      opacity: 1;
    }
  }
</style>
