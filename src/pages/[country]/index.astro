---
import CountryHome from '../../views/CountryHome.astro';
import CountrySoon from '../../views/CountrySoon.astro';
import { countryPaths } from '../../lib/routes';
import type { CountryPageProps } from '../../views/view-types';

export const getStaticPaths = () => countryPaths('fr');

type Props = CountryPageProps;

const props = Astro.props;
---

{props.view === 'soon' ? <CountrySoon {...props} /> : <CountryHome {...props} />}
