---
import '../styles/code-line.css';
import type { Ussd } from '../lib/schema';
import { messages } from '../i18n/messages';
import { pageLang } from '../i18n/paths';
import { codeTokens } from '../lib/ussd-flow';

interface Props {
  ussd: Ussd;
}

const tokens = codeTokens(Astro.props.ussd, messages(pageLang(Astro.url)).client.flow.shorts);
---

<span class="code-line">
  {tokens.map((t) => (t.kind === 'text' ? <span>{t.text}</span> : <span class:list={['code-slot', { 'is-secret': t.secret }]}>{t.short}</span>))}
</span>
