---
import type { CatalogFee } from '../lib/catalog-types';
import { formatXof } from '../lib/format';
import type { Operator } from '../lib/schema';
import BrandMark from './BrandMark.astro';

interface Props {
  fees: CatalogFee[];
  operator: Operator;
}

const { fees, operator } = Astro.props;
const TITLES: Record<string, string> = {
  withdrawal: 'Retrait',
  'transfer-national': 'Transfert',
  'transfer-cross-network': 'Vers un autre opérateur',
  'transfer-regional': 'Transfert UEMOA',
  'transfer-bank': 'Vers la banque',
  deposit: 'Dépôt',
  receive: 'Réception',
  other: 'Autres',
};

const isSecondaryOnly = (fee: CatalogFee): boolean => fee.provenance.sources.every((s) => s.kind === 'secondary');

const groups = Object.keys(TITLES)
  .map((operation) => {
    const rows = fees.filter((f) => f.operation === operation);
    const notes = [...new Set(rows.flatMap((r) => (r.notes ? [r.notes] : [])))];

    return { title: TITLES[operation] ?? operation, rows, notes, unconfirmed: rows.some(isSecondaryOnly) };
  })
  .filter((g) => g.rows.length > 0);

function amount(fee: CatalogFee): string {
  if (fee.fee_xof !== null) return fee.fee_xof === 0 ? 'Gratuit' : formatXof(fee.fee_xof);
  if (fee.fee_percent !== null) return `${String(fee.fee_percent).replace('.', ',')} %`;

  const published = fee.label.split(':')[1]?.trim();
  if (!published || !/\d/.test(published)) return 'Non publié';

  return published
    .replace(/(\d)\s(?=\d{3}\b)/g, '$1 ')
    .replace(/^entre\s+(.+?)\s+(?:à|et)\s+(.+)$/i, '$1 – $2');
}

const PLAIN_AMOUNT = /^(gratuit|[\d\s .,]+\s?F|entre .+)$/i;

function condition(fee: CatalogFee): string {
  const cut = fee.label.lastIndexOf(':');
  if (cut === -1) return fee.label;

  const suffix = fee.label.slice(cut + 1).trim();

  return PLAIN_AMOUNT.test(suffix) ? fee.label.slice(0, cut).trim() : fee.label;
}

const brand = operator.mobile_money ?? operator;
---

<div class="fees">
  <div class="intro">
    <BrandMark brand={brand} size={34} />
    <span class="name">{brand.short_name}</span>
  </div>

  {
    groups.map((group) => (
      <section class="group">
        <h2>{group.title}</h2>
        <dl>
          {group.rows.map((fee) => (
            <div class="line">
              <dt>{condition(fee)}</dt>
              <dd>{amount(fee)}</dd>
            </div>
          ))}
        </dl>
        {group.notes.length > 0 && (
          <details class="note">
            <summary>Détails et sources</summary>
            <ul>
              {group.notes.map((note) => <li>{note}</li>)}
            </ul>
          </details>
        )}
        {group.unconfirmed && <p class="warn">Une partie de ces tarifs vient de la presse : à confirmer.</p>}
      </section>
    ))
  }

  {groups.length === 0 && <p class="empty">Aucun frais publié pour l'instant.</p>}
</div>

<style>
  .fees {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .intro {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .name {
    font-size: 19px;
    font-weight: 800;
  }

  .group {
    padding: var(--space-4) var(--space-5);
    border-radius: var(--radius-md);
    background: var(--surface-raised);
    box-shadow: var(--shadow-card);
  }

  h2 {
    font-size: 16px;
    font-weight: 800;
    margin-bottom: var(--space-2);
  }

  dl {
    margin: 0;
  }

  .line {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
    min-height: 44px;
    padding: var(--space-2) 0;
    align-items: center;
    border-top: 1px solid var(--tag-bg);
  }

  .line:first-child {
    border-top: 0;
  }

  dt {
    font-size: 14px;
    min-width: 0;
  }

  .note ul {
    margin: var(--space-2) 0 0;
    padding-left: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .note {
    font-size: 13px;
    color: var(--text-muted);
  }

  .note summary {
    min-height: 32px;
    display: inline-flex;
    align-items: center;
    color: var(--action-text);
    font-weight: 600;
    cursor: pointer;
  }

  dd {
    margin: 0;
    font-size: 14px;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
    text-align: right;
    flex-shrink: 0;
    max-width: 45%;
  }

  .empty,
  .warn {
    font-size: 14px;
    color: var(--text-muted);
  }
</style>
