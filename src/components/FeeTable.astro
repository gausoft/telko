---
import { messages } from '../i18n/messages';
import { pageLang } from '../i18n/paths';
import type { CatalogFee } from '../lib/catalog-types';
import { feeAmount, feeCondition } from '../lib/fee-text';
import type { Operator } from '../lib/schema';
import BrandMark from './BrandMark.astro';

interface Props {
  fees: CatalogFee[];
  operator: Operator;
}

const { fees, operator } = Astro.props;
const lang = pageLang(Astro.url);
const m = messages(lang);
const TITLES: Record<string, string> = m.fees.operations;
const decimal = lang === 'fr' ? ',' : '.';

const isSecondaryOnly = (fee: CatalogFee): boolean => fee.provenance.sources.every((s) => s.kind === 'secondary');

const groups = Object.keys(TITLES)
  .map((operation) => {
    const rows = fees.filter((f) => f.operation === operation);
    const notes = [...new Set(rows.flatMap((r) => (r.notes ? [r.notes] : [])))];

    return { title: TITLES[operation] ?? operation, rows, notes, unconfirmed: rows.some(isSecondaryOnly) };
  })
  .filter((g) => g.rows.length > 0);

const brand = operator.mobile_money ?? operator;
---

<div class="fees">
  <div class="intro">
    <BrandMark brand={brand} size={34} />
    <span class="name">{brand.short_name}</span>
  </div>

  {
    groups.map((group) => (
      <section class="group">
        <h2>{group.title}</h2>
        <dl>
          {group.rows.map((fee) => (
            <div class="line">
              <dt>{feeCondition(fee)}</dt>
              <dd>{feeAmount(fee, m.fees, decimal)}</dd>
            </div>
          ))}
        </dl>
        {group.notes.length > 0 && (
          <details class="note">
            <summary>{m.fees.details}</summary>
            <ul>
              {group.notes.map((note) => <li>{note}</li>)}
            </ul>
          </details>
        )}
        {group.unconfirmed && <p class="warn">{m.fees.unconfirmed}</p>}
      </section>
    ))
  }

  {groups.length === 0 && <p class="empty">{m.fees.empty}</p>}
</div>

<style>
  .fees {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .intro {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .name {
    font-size: 19px;
    font-weight: 800;
  }

  .group {
    padding: var(--space-4) var(--space-5);
    border-radius: var(--radius-md);
    background: var(--surface-raised);
    box-shadow: var(--shadow-card);
  }

  h2 {
    font-size: 16px;
    font-weight: 800;
    margin-bottom: var(--space-2);
  }

  dl {
    margin: 0;
  }

  .line {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
    min-height: 44px;
    padding: var(--space-2) 0;
    align-items: center;
    border-top: 1px solid var(--tag-bg);
  }

  .line:first-child {
    border-top: 0;
  }

  dt {
    font-size: 14px;
    min-width: 0;
  }

  .note ul {
    margin: var(--space-2) 0 0;
    padding-left: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .note {
    font-size: 13px;
    color: var(--text-muted);
  }

  .note summary {
    min-height: 32px;
    display: inline-flex;
    align-items: center;
    color: var(--action-text);
    font-weight: 600;
    cursor: pointer;
  }

  dd {
    margin: 0;
    font-size: 14px;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
    text-align: right;
    flex-shrink: 0;
    max-width: 45%;
  }

  .empty,
  .warn {
    font-size: 14px;
    color: var(--text-muted);
  }
</style>
