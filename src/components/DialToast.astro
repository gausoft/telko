---
import { messages } from '../i18n/messages';
import { pageLang } from '../i18n/paths';

const m = messages(pageLang(Astro.url));

/**
 * Records each dialed code as a habit (its id only). On devices with a fine pointer (usually
 * computers) it also shows the code, since the tel: link may open nothing.
 * The link itself is never blocked: tablets and desktops with calling apps keep it.
 */
---

<div class="toast" role="status" aria-live="polite" data-dial-toast hidden>
  <span class="hint">{m.toast.hint}</span>
  <span class="code mono" data-dial-code></span>
</div>

<script>
  import { recordUse } from '../db/usage-store';
  import { countryFromPath } from '../i18n/paths';

  const toast = document.querySelector<HTMLElement>('[data-dial-toast]');
  const code = document.querySelector<HTMLElement>('[data-dial-code]');
  let timer = 0;

  document.addEventListener('click', (event) => {
    const link = (event.target as Element | null)?.closest<HTMLAnchorElement>('a[data-dial]');
    if (!link) return;

    const dial = link.dataset['dial'] ?? '';
    const entryId = link.dataset['entry'];
    const country = countryFromPath(window.location.pathname);
    if (entryId) void recordUse({ entryId, country, operator: link.dataset['operator'] ?? '' }).catch(() => undefined);

    if (!window.matchMedia('(pointer: fine)').matches || !toast || !code) return;
    code.textContent = dial;
    toast.hidden = false;
    window.clearTimeout(timer);
    timer = window.setTimeout(() => (toast.hidden = true), 6000);
  });
</script>

<style>
  .toast {
    position: fixed;
    left: 50%;
    bottom: calc(196px + env(safe-area-inset-bottom, 0px));
    transform: translateX(-50%);
    z-index: 30;
    width: min(560px, calc(100% - 32px));
    padding: var(--space-4) var(--space-5);
    border-radius: 18px;
    background: var(--toast);
    color: var(--surface);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .hint {
    font-size: 15px;
  }

  .code {
    font-size: 22px;
    font-weight: 600;
  }
</style>
