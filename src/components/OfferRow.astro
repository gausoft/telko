---
import Pencil from '@lucide/astro/icons/pencil';
import Phone from '@lucide/astro/icons/phone';

import type { CatalogEntry } from '../lib/catalog-types';
import { telHref } from '../lib/dial';
import { formatData, formatXof } from '../lib/format';
import type { Brand } from '../lib/schema';
import BrandMark from './BrandMark.astro';
import CodeLine from './CodeLine.astro';

interface Props {
  entry: CatalogEntry;
  brand: Pick<Brand, 'name' | 'badge' | 'logo'>;
  badge?: string | undefined;
  duration?: string | undefined;
}

const { entry, brand, badge, duration } = Astro.props;
const volume = formatData(entry.allowances?.data_mb ?? null);
const voice = entry.allowances?.voice_min ?? null;
const sms = entry.allowances?.sms ?? null;
const extras = [
  voice === -1 ? 'Appels illimités' : voice ? `${voice} min` : null,
  sms === -1 ? 'SMS illimités' : sms ? `${sms} SMS` : null,
];
const title = volume ?? entry.name;
const meta = [volume ? entry.name : null, ...extras, entry.validity?.label ?? null]
  .filter((v): v is string => v !== null)
  .join(' · ');
const callOffer = entry.category === 'mixed' || entry.category === 'voice-sms';
const description = (callOffer || (!volume && extras.every((e) => e === null))) && entry.description ? entry.description : null;
const price = entry.price_xof !== null ? formatXof(entry.price_xof) : null;
const href = telHref(entry);
const label = `${title}${price ? `, ${price}` : ''}`;
const needsInput = entry.ussd.params.length > 0;
const Tag = href ? 'a' : 'button';
---

<Tag
  class="row"
  href={href ?? undefined}
  data-dial={href ? entry.ussd.template : undefined}
  data-entry={entry.id}
  data-label={href ? label : undefined}
  data-operator={entry.operator}
  data-duration={duration}
  data-build={needsInput ? entry.id : undefined}
  type={href ? undefined : 'button'}
  aria-label={href ? `Composer ${entry.ussd.template} : ${label}` : `Compléter le code : ${title}`}
>
  <BrandMark brand={brand} size={30} />
  <span class="body">
    {badge && <span class="badge mono">{badge}</span>}
    <span class="title">{title}</span>
    {meta && <span class="meta">{meta}</span>}
    {description && <span class="meta">{description}</span>}
    {needsInput ? <CodeLine ussd={entry.ussd} /> : <span class="code mono">{entry.ussd.template}</span>}
  </span>
  {price && <span class="price">{price}</span>}
  <span class:list={['call', { 'call-edit': needsInput }]} aria-hidden="true">
    {needsInput ? <Pencil size={18} /> : <Phone size={20} />}
  </span>
</Tag>

<style>
  .row {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 64px;
    padding: var(--space-3) var(--space-3) var(--space-3) var(--space-3);
    border-radius: var(--radius-md);
    background: var(--surface-raised);
    box-shadow: var(--shadow-card);
    color: var(--text);
    text-decoration: none;
    width: 100%;
    border: 0;
    font: inherit;
    text-align: left;
    cursor: pointer;
  }

  .row:active {
    transform: scale(0.99);
  }

  .body {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .badge {
    align-self: flex-start;
    font-size: 11px;
    font-weight: 600;
    white-space: nowrap;
    padding: 2px 8px;
    border-radius: var(--radius-pill);
    background: var(--tag-bg);
    color: var(--tag-text);
  }

  .title {
    font-size: 18px;
    line-height: 22px;
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .meta {
    font-size: 13px;
    color: var(--text-muted);
    overflow-wrap: anywhere;
  }

  .code {
    font-size: 12px;
    color: var(--text-muted);
    overflow-wrap: anywhere;
  }

  .price {
    font-size: 15px;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .call {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--action);
    color: var(--on-action);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .call-edit {
    background: var(--action-soft);
    color: var(--action-text);
  }
</style>
