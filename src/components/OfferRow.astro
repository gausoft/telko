---
import Pencil from '@lucide/astro/icons/pencil';
import Phone from '@lucide/astro/icons/phone';

import type { CatalogEntry } from '../lib/catalog-types';
import { telHref } from '../lib/dial';
import { formatAmount, formatData } from '../lib/format';
import { fill } from '../i18n/format-message';
import { messages } from '../i18n/messages';
import { pageLang } from '../i18n/paths';
import type { Brand } from '../lib/schema';
import BrandMark from './BrandMark.astro';
import CodeLine from './CodeLine.astro';
import PromoBadge from './PromoBadge.astro';

interface Props {
  entry: CatalogEntry;
  brand: Pick<Brand, 'name' | 'badge' | 'logo'>;
  badge?: string | undefined;
  duration?: string | undefined;
}

const { entry, brand, badge, duration } = Astro.props;
const lang = pageLang(Astro.url);
const m = messages(lang);
const volume = formatData(entry.allowances?.data_mb ?? null, lang);
const voice = entry.allowances?.voice_min ?? null;
const sms = entry.allowances?.sms ?? null;
const extras = [
  voice === -1 ? m.section.unlimitedCalls : voice ? fill(m.section.minutes, { n: voice }) : null,
  sms === -1 ? m.section.unlimitedSms : sms ? fill(m.section.sms, { n: sms }) : null,
];
const title = volume ?? entry.name;
const meta = [volume ? entry.name : null, ...extras, entry.validity?.label ?? null]
  .filter((v): v is string => v !== null)
  .join(' · ');
const callOffer = entry.category === 'mixed' || entry.category === 'voice-sms';
const description = (callOffer || (!volume && extras.every((e) => e === null))) && entry.description ? entry.description : null;
const price = entry.price !== null ? formatAmount(entry.price, entry.amountLabel) : null;
const href = telHref(entry);
const label = `${title}${price ? `, ${price}` : ''}`;
const needsInput = entry.ussd.params.length > 0;
const Tag = href ? 'a' : 'button';
---

<Tag
  class:list={['row', { 'is-promo': badge }]}
  href={href ?? undefined}
  data-dial={href ? entry.ussd.template : undefined}
  data-entry={entry.id}
  data-label={href ? label : undefined}
  data-operator={entry.operator}
  data-duration={duration}
  data-build={needsInput ? entry.id : undefined}
  type={href ? undefined : 'button'}
  aria-label={href ? fill(m.common.dialAria, { code: entry.ussd.template, label }) : fill(m.common.completeAria, { title })}
>
  <BrandMark brand={brand} size={30} />
  <span class="body">
    {badge && <PromoBadge label={badge} />}
    <span class="title">{title}</span>
    {meta && <span class="meta">{meta}</span>}
    {description && <span class="meta">{description}</span>}
    {needsInput ? <CodeLine ussd={entry.ussd} /> : <span class="code mono">{entry.ussd.template}</span>}
  </span>
  {price && <span class="price">{price}</span>}
  <span class:list={['call', { 'call-edit': needsInput }]} aria-hidden="true">
    {needsInput ? <Pencil size={18} /> : <Phone size={20} />}
  </span>
</Tag>

<style>
  .row {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 64px;
    padding: var(--space-3) var(--space-3) var(--space-3) var(--space-3);
    border-radius: var(--radius-md);
    background: var(--surface-raised);
    box-shadow: var(--shadow-card);
    color: var(--text);
    text-decoration: none;
    width: 100%;
    border: 0;
    font: inherit;
    text-align: left;
    cursor: pointer;
  }

  .row:active {
    transform: scale(0.99);
  }

  .body {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .is-promo {
    box-shadow: 0 0 0 2px var(--promo), 0 10px 28px var(--promo-glow);
  }

  .title {
    font-size: 18px;
    line-height: 22px;
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .meta {
    font-size: 13px;
    color: var(--text-muted);
    overflow-wrap: anywhere;
  }

  .code {
    font-size: 12px;
    color: var(--text-muted);
    overflow-wrap: anywhere;
  }

  .price {
    font-size: 15px;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .call {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--action);
    color: var(--on-action);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .call-edit {
    background: var(--action-soft);
    color: var(--action-text);
  }
</style>
