---
import Phone from '@lucide/astro/icons/phone';

import { CAROUSEL_INTERVAL_MS } from '../config';
import type { FeaturedItem } from '../lib/catalog-types';
import { telHref } from '../lib/dial';
import { formatAmount, formatData } from '../lib/format';
import { fill } from '../i18n/format-message';
import { messages } from '../i18n/messages';
import { pageLang } from '../i18n/paths';
import type { Brand } from '../lib/schema';
import BrandMark from './BrandMark.astro';

interface Props {
  items: FeaturedItem[];
  brand: Pick<Brand, 'name' | 'badge' | 'logo'>;
}

const { items, brand } = Astro.props;
const lang = pageLang(Astro.url);
const m = messages(lang);
const slides = items.map((item) => {
  const volume = formatData(item.entry.allowances?.data_mb ?? null, lang);
  const price = item.entry.price !== null ? formatAmount(item.entry.price, item.entry.amountLabel) : null;

  return {
    label: item.label,
    title: volume ?? item.entry.name,
    meta: [item.entry.validity?.label, price].filter((v): v is string => Boolean(v)).join(' · '),
    href: telHref(item.entry),
    code: item.entry.ussd.template,
    operator: item.entry.operator,
    entry: item.entry.id,
  };
});
---

{
  slides.length > 0 && (
    <section class="carousel" data-carousel data-interval={CAROUSEL_INTERVAL_MS} aria-roledescription={m.home.carousel} aria-label={m.home.featured}>
      <div class="track">
        {slides.map((s, i) => (
          <a
            class="slide"
            href={s.href ?? undefined}
            data-dial={s.href ? s.code : undefined}
            data-entry={s.entry}
            data-label={`${s.title}, ${s.meta}`}
            data-operator={s.operator}
            data-slide={i}
            aria-hidden={i === 0 ? undefined : 'true'}
            tabindex={i === 0 ? undefined : -1}
            aria-label={fill(m.home.slideAria, { label: s.label, title: s.title, meta: s.meta, code: s.code })}
          >
            <span class="text">
              <span class="top">
                <BrandMark brand={brand} size={24} />
                <span class="label">{s.label}</span>
              </span>
              <span class="title">{s.title}</span>
              <span class="meta">{s.meta}</span>
            </span>
            <span class="call" aria-hidden="true">
              <Phone size={24} />
            </span>
          </a>
        ))}
      </div>
      {slides.length > 1 && (
        <div class="dots" role="group" aria-label={m.home.pickFeatured}>
          {slides.map((s, i) => (
            <button type="button" class="dot" data-dot={i} aria-label={`${s.title}, ${s.meta}`} aria-current={i === 0 ? 'true' : 'false'} />
          ))}
        </div>
      )}
    </section>
  )
}

<script>
  import { startCarousel } from '../scripts/carousel';

  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach(startCarousel);
</script>

<style>
  .carousel {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  /* One card at a time; it follows the finger and settles on the nearest card. */
  .track {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
    gap: var(--space-4);
  }

  .track::-webkit-scrollbar {
    display: none;
  }

  .slide {
    flex: 0 0 100%;
    scroll-snap-align: start;
    scroll-snap-stop: always;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    min-height: 112px;
    padding: var(--space-4) var(--space-4) var(--space-4) var(--space-5);
    border-radius: var(--radius-lg);
    background: var(--action);
    color: var(--on-action);
    text-decoration: none;
  }

  .text {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  .top {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: 2px;
  }

  .label {
    padding: 3px 10px;
    border-radius: var(--radius-pill);
    background: rgba(255, 255, 255, 0.2);
    color: var(--on-action);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .title {
    font-size: 34px;
    line-height: 38px;
    font-weight: 800;
    letter-spacing: -0.03em;
  }

  .meta {
    font-size: 15px;
    font-weight: 600;
    color: var(--on-action-muted);
  }

  .call {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: #ffffff;
    color: #4b3bff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .dots {
    display: flex;
    justify-content: center;
    gap: 0;
    margin: calc(var(--space-1) * -1) 0;
  }

  .dot {
    min-width: 24px;
    height: 32px;
    border: 0;
    padding: 0;
    background: transparent;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .dot::after {
    content: '';
    width: 8px;
    height: 8px;
    border-radius: var(--radius-pill);
    background: var(--dot);
    transition:
      width 0.25s ease,
      background 0.25s ease;
  }

  .dot[aria-current='true']::after {
    width: 22px;
    background: var(--action);
  }
</style>
