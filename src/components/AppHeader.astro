---
import ArrowLeft from '@lucide/astro/icons/arrow-left';

import type { Country, Operator } from '../lib/schema';
import OperatorSwitcher from './OperatorSwitcher.astro';

interface Props {
  country: Country;
  back?: string | undefined;
  title?: string | undefined;
  /** Operator selector shown top right. `hrefTemplate` makes a pick open that URL ("{op}" is replaced). */
  switcher?: { operators: Operator[]; current: string; hrefTemplate?: string } | undefined;
}

const { country, back, title, switcher } = Astro.props;
---

<header class="header">
  {
    back ? (
      <a class="back" href={back} aria-label="Retour">
        <ArrowLeft size={24} aria-hidden="true" />
      </a>
    ) : (
      <a class="brand" href={`/${country.code}`} aria-label="Telko, accueil">
        <img src="/telko-symbol.svg" alt="" width="28" height="28" />
        <span class="wordmark">telk<span class="dot" /></span>
      </a>
    )
  }
  {title && <h1 class="title">{title}</h1>}
  {switcher && <OperatorSwitcher operators={switcher.operators} current={switcher.current} hrefTemplate={switcher.hrefTemplate} />}
</header>

<style>
  .header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    min-height: 48px;
  }

  .brand,
  .back {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--text);
    text-decoration: none;
    min-height: var(--touch);
  }

  .back {
    width: var(--touch);
    justify-content: center;
    margin-left: calc(var(--space-2) * -1);
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    font-size: 23px;
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .dot {
    width: 12px;
    height: 12px;
    margin: 6px 0 0 1px;
    border-radius: 50%;
    background: var(--action);
  }

  .title {
    flex: 1;
    font-size: 21px;
    font-weight: 800;
  }
</style>
