---
import ArrowLeft from '@lucide/astro/icons/arrow-left';

import type { Country, Operator } from '../lib/schema';
import BrandMark from './BrandMark.astro';

interface Props {
  country: Country;
  back?: string | undefined;
  title?: string | undefined;
  /** Operator switch on operator pages: each logo links to the same page for that operator. */
  switcher?: { operators: Operator[]; current: string; section: string } | undefined;
}

const { country, back, title, switcher } = Astro.props;
---

<header class="header">
  {
    back ? (
      <a class="back" href={back} aria-label="Retour">
        <ArrowLeft size={24} aria-hidden="true" />
      </a>
    ) : (
      <a class="brand" href={`/${country.code}`} aria-label="Telko, accueil">
        <img src="/telko-symbol.svg" alt="" width="28" height="28" />
        <span class="wordmark">telk<span class="dot" /></span>
      </a>
    )
  }
  {title && <h1 class="title">{title}</h1>}
  {
    switcher && switcher.operators.length > 1 && (
      <nav class="operators" aria-label="Opérateur">
        {switcher.operators.map((o) => (
          <a href={`/${country.code}/${o.id}/${switcher.section}`} aria-label={o.short_name} aria-current={o.id === switcher.current ? 'page' : undefined}>
            <BrandMark brand={o} size={30} />
          </a>
        ))}
      </nav>
    )
  }
</header>

<style>
  .header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    min-height: 48px;
  }

  .brand,
  .back {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--text);
    text-decoration: none;
    min-height: var(--touch);
  }

  .back {
    width: var(--touch);
    justify-content: center;
    margin-left: calc(var(--space-2) * -1);
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    font-size: 23px;
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .dot {
    width: 12px;
    height: 12px;
    margin: 6px 0 0 1px;
    border-radius: 50%;
    background: var(--action);
  }

  .title {
    flex: 1;
    font-size: 21px;
    font-weight: 800;
  }

  .operators {
    display: flex;
    gap: 2px;
    padding: 3px;
    border-radius: var(--radius-pill);
    background: var(--surface-raised);
    box-shadow: var(--shadow-card);
  }

  .operators a {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    opacity: 0.55;
  }

  .operators a[aria-current='page'] {
    opacity: 1;
    box-shadow: 0 0 0 2px var(--action);
  }
</style>
