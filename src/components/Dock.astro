---
import House from '@lucide/astro/icons/house';
import Search from '@lucide/astro/icons/search';
import Signal from '@lucide/astro/icons/signal';
import Wallet from '@lucide/astro/icons/wallet';
import Settings from '@lucide/astro/icons/settings';

import { messages } from '../i18n/messages';
import { localePath, pageLang } from '../i18n/paths';
import type { Operator } from '../lib/schema';

interface Props {
  country: string;
  operators: Operator[];
  /** Operator the links point to when the page is rendered. */
  operator: string;
  /** True on operator pages: the page's operator wins over the saved one. */
  pinned?: boolean;
  current: 'accueil' | 'internet' | 'argent' | 'recherche' | 'reglages' | 'none';
}

const { country, operators, operator, pinned = false, current } = Astro.props;
const lang = pageLang(Astro.url);
const m = messages(lang);
const moneyLabels = Object.fromEntries(operators.map((o) => [o.id, o.mobile_money?.short_name ?? m.common.mobileMoney]));
const opHref = (section: string): string => localePath(lang, `/${country}/{op}/${section}`);
const items = [
  { id: 'accueil', label: m.common.home, href: localePath(lang, `/${country}`), template: null, Icon: House },
  { id: 'internet', label: m.sections.internet, href: opHref('internet').replace('{op}', operator), template: opHref('internet'), Icon: Signal },
  { id: 'argent', label: moneyLabels[operator] ?? m.common.mobileMoney, href: opHref('argent').replace('{op}', operator), template: opHref('argent'), Icon: Wallet },
  { id: 'reglages', label: m.common.settings, href: localePath(lang, `/${country}/reglages`), template: null, Icon: Settings },
] as const;
const [home, internet, money, settings] = items;
---

<nav class="dock" aria-label={m.common.mainNav} data-dock data-operator={operator} data-pinned={pinned ? 'true' : undefined} data-money-labels={JSON.stringify(moneyLabels)}>
  {
    [home, internet].map(({ id, label, href, template, Icon }) => (
      <a href={href} data-operator-href={template ?? undefined} aria-current={current === id ? 'page' : undefined}>
        <Icon size={22} aria-hidden="true" />
        <span>{label}</span>
      </a>
    ))
  }
  <a class="fab" href={localePath(lang, `/${country}/recherche`)} aria-label={m.common.search} aria-current={current === 'recherche' ? 'page' : undefined}>
    <Search size={24} aria-hidden="true" />
  </a>
  {
    [money, settings].map(({ id, label, href, template, Icon }) => (
      <a href={href} data-operator-href={template ?? undefined} aria-current={current === id ? 'page' : undefined}>
        <Icon size={22} aria-hidden="true" />
        <span data-money-label={id === 'argent' ? '' : undefined}>{label}</span>
      </a>
    ))
  }
</nav>

<script>
  import { readPref, writePref } from '../scripts/prefs';

  const dock = document.querySelector<HTMLElement>('[data-dock]');
  const labels = JSON.parse(dock?.dataset['moneyLabels'] ?? '{}') as Record<string, string>;

  function point(operator: string): void {
    if (!(operator in labels)) return;
    document.querySelectorAll<HTMLAnchorElement>('[data-operator-href]').forEach((a) => {
      a.href = (a.dataset['operatorHref'] ?? '').replace('{op}', operator);
    });
    const label = document.querySelector<HTMLElement>('[data-money-label]');
    if (label) label.textContent = labels[operator] ?? label.textContent;
  }

  if (dock?.dataset['pinned']) writePref('operator', dock.dataset['operator'] ?? '');
  else point(readPref('operator') ?? '');

  document.addEventListener('telko:operator', (e) => point((e as CustomEvent<string>).detail));
</script>

<style>
  .dock {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 20;
    max-width: 640px;
    margin: 0 auto;
    padding: var(--space-1) var(--space-2) calc(var(--space-1) + env(safe-area-inset-bottom, 0px));
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    align-items: end;
    background: var(--dock);
    border-radius: var(--radius-lg) var(--radius-lg) 0 0;
    box-shadow: var(--shadow-dock);
  }

  a {
    min-height: 52px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 3px;
    color: var(--text-muted);
    text-decoration: none;
    font-size: 11px;
    font-weight: 700;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  a[aria-current='page'] {
    color: var(--action-text);
  }

  .fab {
    justify-self: center;
    width: 56px;
    height: 56px;
    min-height: 0;
    margin-bottom: 14px;
    border-radius: 50%;
    background: var(--action);
    color: var(--on-action);
    box-shadow: var(--shadow-hero);
    overflow: visible;
  }

  .fab[aria-current='page'] {
    color: var(--on-action);
    box-shadow: 0 0 0 4px var(--action-soft), var(--shadow-hero);
  }
</style>
