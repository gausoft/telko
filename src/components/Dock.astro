---
import House from '@lucide/astro/icons/house';
import Search from '@lucide/astro/icons/search';
import Signal from '@lucide/astro/icons/signal';
import Wallet from '@lucide/astro/icons/wallet';
import LifeBuoy from '@lucide/astro/icons/life-buoy';
import ChevronUp from '@lucide/astro/icons/chevron-up';

interface Props {
  country: string;
  operator: string;
  current: 'accueil' | 'internet' | 'argent' | 'aide' | 'recherche';
}

const { country, operator, current } = Astro.props;
const items = [
  { id: 'accueil', label: 'Accueil', href: `/${country}`, Icon: House },
  { id: 'internet', label: 'Internet', href: `/${country}/${operator}/internet`, Icon: Signal },
  { id: 'argent', label: 'Argent', href: `/${country}/${operator}/argent`, Icon: Wallet },
  { id: 'aide', label: 'Aide', href: `/${country}/${operator}/aide`, Icon: LifeBuoy },
] as const;
---

<div class="dock" data-dock>
  {
    current !== 'recherche' && (
      <>
        <button type="button" class="handle" data-search-toggle aria-expanded="false" aria-controls="dock-search" aria-label="Rechercher">
          <ChevronUp size={20} aria-hidden="true" />
        </button>
        <form id="dock-search" class="search" action={`/${country}/recherche`} method="get" role="search" hidden>
          <Search size={20} aria-hidden="true" />
          <input type="search" name="q" placeholder="Forfait, solde, frais…" enterkeyhint="search" autocomplete="off" aria-label="Rechercher" />
        </form>
      </>
    )
  }
  <nav aria-label="Navigation principale">
    {
      items.map(({ id, label, href, Icon }) => (
        <a href={href} data-operator-href={href.includes(`/${operator}/`) ? href.replace(`/${operator}/`, '/{op}/') : undefined} aria-current={current === id ? 'page' : undefined}>
          <Icon size={22} aria-hidden="true" />
          <span>{label}</span>
        </a>
      ))
    }
  </nav>
</div>

<script>
  import { readPref } from '../scripts/prefs';

  const dock = document.querySelector<HTMLElement>('[data-dock]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-search-toggle]');
  const form = document.querySelector<HTMLFormElement>('#dock-search');
  const input = form?.querySelector<HTMLInputElement>('input');

  // Focus runs inside the tap handler so mobile browsers open the keyboard.
  toggle?.addEventListener('click', () => {
    if (!form || !input) return;
    const open = form.hidden;
    form.hidden = !open;
    toggle.setAttribute('aria-expanded', String(open));
    dock?.classList.toggle('is-open', open);
    if (open) input.focus();
  });

  const operator = readPref('operator');
  if (operator && /^[a-z0-9-]+$/.test(operator)) {
    document.querySelectorAll<HTMLAnchorElement>('[data-operator-href]').forEach((a) => {
      a.href = (a.dataset['operatorHref'] ?? '').replace('{op}', operator);
    });
  }
</script>

<style>
  .dock {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 20;
    max-width: 640px;
    margin: 0 auto;
    padding: var(--space-2) var(--space-3) calc(var(--space-1) + env(safe-area-inset-bottom, 0px));
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    background: var(--dock);
    border-radius: var(--radius-lg) var(--radius-lg) 0 0;
    box-shadow: var(--shadow-dock);
  }

  .handle {
    position: absolute;
    top: -18px;
    left: 50%;
    width: 52px;
    height: 36px;
    margin-left: -26px;
    border: 0;
    border-radius: var(--radius-pill);
    background: var(--dock);
    box-shadow: var(--shadow-dock);
    color: var(--text-muted);
    display: grid;
    place-items: center;
    cursor: pointer;
  }

  .handle :global(svg) {
    transition: transform 0.2s ease;
  }

  .is-open .handle :global(svg) {
    transform: rotate(180deg);
  }

  .search {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    height: 48px;
    margin-top: var(--space-3);
    padding: 0 var(--space-4);
    border-radius: var(--radius-sm);
    background: var(--action-soft);
    color: var(--action-text);
  }

  .search[hidden] {
    display: none;
  }

  .search input {
    flex: 1;
    min-width: 0;
    height: 100%;
    border: 0;
    background: transparent;
    color: var(--text);
    font: inherit;
    font-size: 16px;
    outline: none;
  }

  .search input::placeholder {
    color: var(--text-muted);
  }

  .search:focus-within {
    box-shadow: 0 0 0 2px var(--focus);
  }

  nav {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  nav a {
    min-height: 52px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 3px;
    color: var(--text-muted);
    text-decoration: none;
    font-size: 11px;
    font-weight: 700;
  }

  nav a[aria-current='page'] {
    color: var(--action-text);
  }
</style>
